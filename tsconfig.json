{
  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@taskforce/database": ["packages/database"],
    }
  },
  "include": ["apps"],
  "exclude": [".github", ".vscode"]
}
